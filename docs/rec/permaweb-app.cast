[64.253, "o", "\u001b[90m  96\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mtry\u001b[39;49;00m\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[64.308, "o", "\u001b[90m  97\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mawait\u001b[39;49;00m\u001b[90m \u001b[39;49;00mclient.query(\u001b[33m\"begin\"\u001b[39;49;00m);\u001b[90m\u001b[39;49;00m\n"]
[64.363, "o", "\u001b[90m  98\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00maccount\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94mawait\u001b[39;49;00m\u001b[90m \u001b[39;49;00mclient.query<{\u001b[90m \u001b[39;49;00mcredits_clp:\u001b[90m \u001b[39;49;00m\u001b[96mstring\u001b[39;49;00m;\u001b[90m \u001b[39;49;00mbanned_at:\u001b[90m \u001b[39;49;00m\u001b[96mDate\u001b[39;49;00m\u001b[90m \u001b[39;49;00m|\u001b[90m \u001b[39;49;00m\u001b[94mnull\u001b[39;49;00m\u001b[90m \u001b[39;49;00m}>(\u001b[90m\u001b[39;49;00m\n"]
[64.418, "o", "\u001b[90m  99\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m\u001b[33m\"select credits_clp, banned_at from users where id = $1 for update\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[64.473, "o", "\u001b[90m 100\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m[user.id],\u001b[90m\u001b[39;49;00m\n"]
[64.528, "o", "\u001b[90m 101\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m);\u001b[90m\u001b[39;49;00m\n"]
[64.583, "o", "\u001b[90m 102\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(!account.rows[\u001b[94m0\u001b[39;49;00m]\u001b[90m \u001b[39;49;00m||\u001b[90m \u001b[39;49;00maccount.rows[\u001b[94m0\u001b[39;49;00m].banned_at)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[64.638, "o", "\u001b[90m 103\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00mfailure\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m{\u001b[90m \u001b[39;49;00mstatus:\u001b[90m \u001b[39;49;00m\u001b[96m403\u001b[39;49;00m,\u001b[90m \u001b[39;49;00mbody:\u001b[90m \u001b[39;49;00m{\u001b[90m \u001b[39;49;00merror:\u001b[90m \u001b[39;49;00m\u001b[33m\"La cuenta no está habilitada\"\u001b[39;49;00m\u001b[90m \u001b[39;49;00m}\u001b[90m \u001b[39;49;00m};\u001b[90m\u001b[39;49;00m\n"]
[64.693, "o", "\u001b[90m 104\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m}\u001b[90m \u001b[39;49;00m\u001b[94melse\u001b[39;49;00m\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[64.748, "o", "\u001b[90m 105\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00moccupied\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94mawait\u001b[39;49;00m\u001b[90m \u001b[39;49;00mclient.query(\u001b[33m\"select 1 from uploads where slug = $1\"\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m[ref]);\u001b[90m\u001b[39;49;00m\n"]

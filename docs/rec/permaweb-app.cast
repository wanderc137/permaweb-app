[148.596, "o", "\u001b[90m  49\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00mnow\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[96mDate\u001b[39;49;00m.now();\u001b[90m\u001b[39;49;00m\n"]
[148.651, "o", "\u001b[90m  50\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(buckets.size\u001b[90m \u001b[39;49;00m>\u001b[90m \u001b[39;49;00m\u001b[94m5000\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
